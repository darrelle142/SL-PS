\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Safety-Optimization Duality across Prioritized Sweeping budgets $K \in \{0, 2, 5, 10, 20, 50\}$ on $G_{20,20}$.} \textbf  {(a)} At $K \in \{0, 2\}$, SL-PS guarantees $0.0\%$ trap commitment via the sign-safe resolvent warm-start $V^{(0)}$, but takes a conservative secondary detour ($182.4$~s) due to unsigned divergence $|B\Delta \vec  {\ell }|$ on the relieved primary bypass. At $K=5$, canonical Bellman backups unlock the relieved bypass, reducing latency by $42.3\%$ ($105.2$~s), whereas Standard-PS remains trapped inside the 2D merge-cone barrier ($K < 6$). \textbf  {(b)} Geometric contraction of the active-corridor value error $\|V^{(K)} - V^*\|_{\infty , \mathcal  {V}_{\text  {act}}}$ (Theorem~\ref {thm:pareto_optimality}), showing the $46.2\%$ error reduction of $P_{\text  {flow}}$ over $P_{\text  {unif}}$ at $K=5$ (Theorem~\ref {thm:resolvent_mismatch}).}}{19}{figure.2}\protected@file@percent }
\newlabel{fig:duality_sweep}{{2}{19}{\textbf {Safety-Optimization Duality across Prioritized Sweeping budgets $K \in \{0, 2, 5, 10, 20, 50\}$ on $G_{20,20}$.} \textbf {(a)} At $K \in \{0, 2\}$, SL-PS guarantees $0.0\%$ trap commitment via the sign-safe resolvent warm-start $V^{(0)}$, but takes a conservative secondary detour ($182.4$~s) due to unsigned divergence $|B\Delta \vec {\ell }|$ on the relieved primary bypass. At $K=5$, canonical Bellman backups unlock the relieved bypass, reducing latency by $42.3\%$ ($105.2$~s), whereas Standard-PS remains trapped inside the 2D merge-cone barrier ($K < 6$). \textbf {(b)} Geometric contraction of the active-corridor value error $\|V^{(K)} - V^*\|_{\infty , \mathcal {V}_{\text {act}}}$ (Theorem~\ref {thm:pareto_optimality}), showing the $46.2\%$ error reduction of $P_{\text {flow}}$ over $P_{\text {unif}}$ at $K=5$ (Theorem~\ref {thm:resolvent_mismatch})}{figure.2}{}}
