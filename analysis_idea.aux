\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Lipschitz robustness and real-world urban network evaluation.} \textbf  {(a)} Sensitivity of SL-PS ($P_{\text  {flow}}, K=5$) to relative Wardrop flow estimation error $\delta \in [0.00, 0.60]$ (Theorem~\ref {thm:lipschitz_stability}), confirming $0.0\%$ trap rate and linear $\mathcal  {O}(\delta )$ error drift throughout the analytical stability ball $\delta \le \delta _{\text  {crit}} \approx 0.38$. \textbf  {(b)} Benchmark on the cyclic 24-node, 76-link Sioux Falls urban arterial network, where SL-PS eliminates Braess traps ($0.0\%$ vs.\ $86.0\%$--$93.0\%$), reduces traversal latency by $44.4\%$, and achieves a $1{,}797\times $ online computational speedup over iterative Beckmann convex optimization.}}{20}{figure.3}\protected@file@percent }
\newlabel{fig:lipschitz_sioux}{{3}{20}{\textbf {Lipschitz robustness and real-world urban network evaluation.} \textbf {(a)} Sensitivity of SL-PS ($P_{\text {flow}}, K=5$) to relative Wardrop flow estimation error $\delta \in [0.00, 0.60]$ (Theorem~\ref {thm:lipschitz_stability}), confirming $0.0\%$ trap rate and linear $\mathcal {O}(\delta )$ error drift throughout the analytical stability ball $\delta \le \delta _{\text {crit}} \approx 0.38$. \textbf {(b)} Benchmark on the cyclic 24-node, 76-link Sioux Falls urban arterial network, where SL-PS eliminates Braess traps ($0.0\%$ vs.\ $86.0\%$--$93.0\%$), reduces traversal latency by $44.4\%$, and achieves a $1{,}797\times $ online computational speedup over iterative Beckmann convex optimization}{figure.3}{}}
